# Copy to .env.local and provide temporary UAT values. Never commit .env.local.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_URL=postgresql://postgres:<percent-encoded-password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CLEARWAY_ALLOW_UAT_FIXTURE_FALLBACK=false
