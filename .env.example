# Copy to .env.foundry.local on the whitelisted work laptop.
# Never commit .env.foundry.local or any bearer token.

# Full stable Responses-protocol endpoint copied from the Foundry agent's
# Configure/Share page. It must end with:
# /endpoint/protocols/openai/responses
CLEARWAY_FOUNDRY_AGENT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols/openai/responses

# Preferred authentication: an approved Microsoft Entra token command.
# The calling identity needs Foundry Agent Consumer (or Foundry User) at the
# project/agent scope. API key authentication is not supported by this endpoint.
CLEARWAY_FOUNDRY_TOKEN_COMMAND=az account get-access-token --scope https://ai.azure.com/.default --query accessToken -o tsv

# Optional request timeout.
CLEARWAY_FOUNDRY_TIMEOUT_SECONDS=90

# Optional only for a short-lived local process if corporate tooling supplies a
# token another way. Never save a real token here or commit it.
# CLEARWAY_FOUNDRY_BEARER_TOKEN=[REDACTED]
